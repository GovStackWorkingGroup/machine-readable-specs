<?xml version="1.0" encoding="UTF-8"?>
<testcase id="credentialOffer" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>8.1.1. Credential Offer Endpoint</gitb:name>
        <gitb:version>1.0.0</gitb:version>
        <gitb:description>This endpoint is used by a credential issuer that is already interacting with a Holder who wishes to initiate a credential issuance. It is used to pass available information relevant for the credential issuance to ensure a convenient and secure process.</gitb:description>
        <gitb:specification>
            <gitb:reference>govstack-bb-wallet-kdf-4_1</gitb:reference>
            <gitb:description>A wallet holder who intends to receive credentials from an issuer should be able to get relevant information on how to obtain the credentials, so that, the process of credential issuance is convenient and secure.</gitb:description>
            <gitb:link>https://wallet.govstack.global/4-key-digital-functionalities#id-1.1.-importing-credentials-into-wallet</gitb:link>
        </gitb:specification>
    </metadata>
    <actors>
        <gitb:actor id="digitalWallet" name="digitalWallet" role="SUT">
            <gitb:endpoint name="info">
                <gitb:config name="credentialOfferEndpoint" kind="SIMPLE" use="R" label="Credential Offer Endpoint"/>
            </gitb:endpoint>
        </gitb:actor>
        <gitb:actor id="Issuer" name="Credential Issuer"/>
    </actors>
    <steps>
        <send id="dataSend" desc="Send data" handler="HttpMessagingV2">
            <input name="uri">$SYSTEM{API_BASE_URL} || $digitalWallet{credentialOfferEndpoint} || '/'</input>
            <input name="method">"GET"</input>
        </send>
        <log>$dataSend{response}{status}</log>

        <verify handler="StringValidator" desc="Validate status">
            <input name="actual">$dataSend{response}{status}</input>
            <input name="expected">"200"</input>
            <input name="failureMessage">"The received HTTP status was not 200."</input>
        </verify>
    </steps>
    <output>
        <success>
            <default>"Test session completed successfully."</default>
        </success>
        <failure>
            <default>"The test session resulted in a failure. Please check the validation reports and apply required corrections."</default>
        </failure>
    </output>
</testcase>