{
  "$id": "https://example.com/schemas/person",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Person",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "description": "Unique identifier for the person",
      "pattern": "^govstack-person-[0-9]+$",
      "examples": [
        "govstack-person-1",
        "govstack-person-20",
        "govstack-person-1000"
      ]
    },
    "name": {
      "type": "string",
      "description": "Full name of the person"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the person"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Personal website of the user"
    },
    "affiliation": {
      "type": "object",
      "description": "Affiliation or organization the person belongs to",
      "properties": {
        "name": { "type": "string", "description": "Name of the organization" },
        "url": { "type": "string", "format": "uri", "description": "Organization website" }
      }
    }
  },
  "required": ["identifier", "name"]
}