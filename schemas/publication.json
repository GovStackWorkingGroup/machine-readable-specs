{
  "$id": "https://example.com/schemas/publication",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "description": "Unique identifier for the publication"
    },
    "title": {
      "type": "string",
      "description": "Title of the publication"
    },
    "versionNumber": {
      "type": "string",
      "description": "Current version number of the publication (e.g., '1.0', '2.1')"
    },
    "authors": {
      "type": "array",
      "items": {
        "$ref": "/schemas/person"
      },
      "description": "List of authors of the publication"
    },
    "publishedDate": {
      "type": "string",
      "format": "date",
      "description": "Date when the publication was published"
    },
    "workingGroup": {
      "$ref": "/schemas/working-group",
      "description": "Associated working group for the publication"
    },
    "versionHistory": {
      "type": "array",
      "description": "Version history of the publication",
      "items": {
        "allOf": [
          {
            "$ref": "#"
          },
          {
            "type": "object",
            "properties": {
              "title": false,
              "workingGroup": false,
              "content": false
            },
            "required": ["identifier", "versionNumber", "publishedDate", "authors"]
          }
        ]
      }
    },
    "content": {
      "type": "object",
      "description": "Content of the publication (to be defined by specific implementations)"
    },
    "releaseNotes": {
      "$ref": "/schemas/release-notes",
      "description": "Optional link to a release notes document for this publication"
    }
  },
  "required": ["identifier", "title", "versionNumber", "authors", "publishedDate", "content"]
}