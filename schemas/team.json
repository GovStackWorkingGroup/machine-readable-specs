{
  "$id": "https://example.com/schemas/team",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team",
  "type": "object",
  "properties": {
    "identifier": { "type": "string", "description": "Unique identifier for the team" },
    "name": { "type": "string", "description": "Team name" },
    "description": { "type": "string", "description": "Team description" },
    "slug": { "type": "string", "description": "URL-friendly slug for the team that also serves as a human-friendly name and follows govstack convention" },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "closed"],
      "description": "Current lifecycle status of the team"
    },
    "members": {
      "type": "array",
      "items": { "type": "string", "description": "Reference to a person identifier" },
      "description": "List of member identifiers in the team"
    },
    "projects": {
      "type": "array",
      "items": { "type": "string", "description": "Reference to a project identifier" },
      "description": "List of project identifiers undertaken by the team"
    },
    "publications": {
      "type": "array",
      "items": { "type": "string", "description": "Reference to a publication identifier" },
      "description": "List of publication identifiers produced by the team"
    }
  },
  "required": ["identifier", "name", "status", "members"]
}
