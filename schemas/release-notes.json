{
  "$id": "https://example.com/schemas/release-notes",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Notes",
  "allOf": [
    {
      "$ref": "/schemas/publication"
    },
    {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "description": "Unique identifier for the release notes"
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "/schemas/person"
          },
          "description": "List of authors of the release notes"
        }
      },
      "required": ["identifier", "authors"],
      "propertiesToRemove": ["versionHistory", "workingGroup", "versionNumber"]
    }
  ]
}