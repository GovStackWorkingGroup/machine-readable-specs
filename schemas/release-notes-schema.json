{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Notes",
  "allOf": [
    {
      "$ref": "publication-schema.json"
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the release notes"
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "person-schema.json"
          },
          "description": "List of authors of the release notes"
        }
      },
      "required": ["id", "authors"],
      "propertiesToRemove": ["versionHistory", "workingGroup", "versionNumber"]
    }
  ]
}